<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ValidatopiaIssuerUrl</key>
	<string>$(VALIDATOPIA_ISSUER_URL)</string>
	<!-- Online sharing requests (OpenID4VP, and ISO/IEC 18013-7 Annex A) that a website or app
	     opens in the wallet. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Online sharing request</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openid4vp</string>
				<string>haip-vp</string>
				<string>mdoc</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A development issuer on this Mac or the local network is plain HTTP. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
